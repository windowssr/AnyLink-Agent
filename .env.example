DATABASE_URL=postgresql://anylink:CHANGE_ME@127.0.0.1:55432/anylink
OWNER_TOKEN=GENERATE_A_RANDOM_TOKEN
ANYLINK_JOIN_KEY=GENERATE_A_RANDOM_KEY
# Optional memorable login password (>=6 chars) for quick Web Admin & device connect (never commit real passwords)
# ANYLINK_LOGIN_PASSWORD=CONFIGURE_ONLY_ON_SERVER
DEEPSEEK_API_KEY=CONFIGURE_ONLY_ON_SERVER
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
APP_ORIGIN=http://127.0.0.1:3180
HOST=127.0.0.1
PORT=3180

# Optional Aliyun Bailian speech (server only). With a key, sweet-lively prefers Momo;
# failure falls back to the original Microsoft neural voice, then client system TTS.
# Set provider=microsoft to explicitly retain the original primary voice.
# ANYLINK_TTS_PROVIDER=qwen
# ANYLINK_QWEN_TTS_API_KEY_FILE=/run/secrets/dashscope-api-key
# DASHSCOPE_API_KEY_FILE is also accepted; never put keys in an APK or client config.
# ANYLINK_QWEN_TTS_REGION=beijing
# ANYLINK_QWEN_TTS_MODEL=qwen3-tts-flash-realtime
# ANYLINK_QWEN_TTS_VOICE=Momo
# ANYLINK_QWEN_TTS_SPEECH_RATE=1.12
