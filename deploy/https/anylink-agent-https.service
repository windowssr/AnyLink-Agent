[Unit]
Description=AnyLink device HTTPS endpoint
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
DynamicUser=true
StateDirectory=anylink-agent-https
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/anylink-agent-https/data
Environment=XDG_CONFIG_HOME=/var/lib/anylink-agent-https/config
EnvironmentFile=/opt/anylink-agent-https/public.env
ExecStart=/opt/anylink-agent-https/caddy run --config /opt/anylink-agent-https/Caddyfile --adapter caddyfile
ExecReload=/opt/anylink-agent-https/caddy reload --config /opt/anylink-agent-https/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=150s
LimitNOFILE=65536
MemoryMax=192M
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
