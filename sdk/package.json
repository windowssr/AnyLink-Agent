{
  "name": "@anylink-agent/sdk",
  "version": "0.9.0",
  "description": "Harness-independent Protocol v3.2 SDK for Personal Agent Networks (Cloud Memory Brain, Multi-Model Gateway, resilient WebSocket bus, interactive tasks & artifacts)",
  "type": "module",
  "license": "MIT",
  "keywords": ["agent", "personal-agent", "shared-memory", "websocket", "protocol", "sdk", "anylink"],
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/client.d.mts",
      "import": "./src/client.mjs"
    },
    "./worker": {
      "types": "./src/worker.d.mts",
      "import": "./src/worker.mjs"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/windowssr/AnyLink-Agent.git",
    "directory": "sdk"
  }
}
