{
  "name": "anylink-agent",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "test:sdk": "node --test sdk/tests/*.test.mjs",
    "test:mcp": "node --test mcp/tests/*.test.mjs",
    "test:python": "uv run --project sdk-python --extra dev pytest sdk-python/tests",
    "protocol:generate": "node --import tsx scripts/generate-protocol.mjs",
    "protocol:check": "node --import tsx scripts/generate-protocol.mjs --check",
    "repo:sync": "node scripts/sync-repositories.mjs",
    "release:audit": "node scripts/audit-public.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "desktop:build": "node examples/mac-openclaw/build-app.mjs",
    "desktop:install": "node examples/mac-openclaw/install-app.mjs",
    "desktop:control:install": "node examples/mac-openclaw/install-control.mjs",
    "desktop:companion:install": "node examples/mac-openclaw/companion/install.mjs",
    "desktop:companion:configure": "node examples/mac-openclaw/configure-companion.mjs",
    "test:companion": "node --test examples/mac-openclaw/companion/*.test.mjs && node examples/mac-openclaw/companion/asset-check.mjs",
    "test:mac-control": "node --test examples/mac-openclaw/control/*.test.mjs",
    "start": "node dist/server/index.js",
    "desktop:voice:install": "node examples/mac-openclaw/voice/install.mjs",
    "test:voice:input": "PYTHONPYCACHEPREFIX=artifacts/python-cache python3 examples/mac-openclaw/voice/test_synthesize.py",
    "desktop:branding": "node examples/mac-openclaw/branding/install.mjs",
    "test:peer": "node --test examples/mac-openclaw/peer/*.test.mjs",
    "test:mac": "node --test examples/mac-openclaw/connect.test.mjs examples/mac-openclaw/configure-remote.test.mjs examples/mac-openclaw/plugin/*.test.mjs examples/mac-openclaw/peer/*.test.mjs",
    "test:mac-interaction": "node examples/mac-openclaw/test-interaction.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "fastify": "^5.6.2",
    "msedge-tts": "2.1.1",
    "pg": "^8.16.3",
    "ws": "^8.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "license": "MIT",
  "description": "Harness-independent protocol and SDK for shared memory and host-owned device tasks",
  "repository": {
    "type": "git",
    "url": "https://github.com/windowssr/AnyLink-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/windowssr/AnyLink-Agent/issues"
  }
}
