{
  "id": "anylink-memory",
  "name": "AnyLink Cloud Memory",
  "description": "Shared cloud facts for Mac-hosted agents and explicitly selected logical device contexts. Never runs a cloud agent.",
  "version": "0.2.0",
  "contracts": {
    "tools": [
      "anylink_memory_search",
      "anylink_memory_save",
      "anylink_memory_update",
      "anylink_memory_delete"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "connectionFile": {
        "type": "string"
      },
      "deviceConnections": {
        "type": "object",
        "description": "Exact host-configured agent IDs mapped to logical device credentials; this is not physical input-device authentication.",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "connectionFile": {"type": "string", "minLength": 1},
            "label": {"type": "string", "minLength": 1, "maxLength": 80},
            "platform": {"type": "string", "enum": ["android", "macos", "other"]}
          },
          "required": ["connectionFile"],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "connectionFile"
    ],
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "toolMetadata": {
    "anylink_memory_search": {
      "profiles": [
        "coding"
      ]
    },
    "anylink_memory_save": {
      "profiles": [
        "coding"
      ]
    },
    "anylink_memory_update": {
      "profiles": [
        "coding"
      ]
    },
    "anylink_memory_delete": {
      "profiles": [
        "coding"
      ]
    }
  }
}
