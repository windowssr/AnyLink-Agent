  "components": {
    "securitySchemes": {
      "deviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Revocable device service credential, not an LLM provider key"
      },
      "ownerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "anylink_session",
        "description": "Session from POST /v1/auth/login; provision devices and credentials through /v1/devices"
      }
    },
    "schemas": {
      "Capabilities": {
        "type": "object",
        "properties": {
          "capabilities": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 100,
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "name",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "capabilities"
        ],
        "additionalProperties": false
      },
      "TaskInput": {
        "type": "object",
        "properties": {
          "target_device_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "capability": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "ttl_seconds": {
            "default": 1800,
            "type": "integer",
            "minimum": 10,
            "maximum": 86400
          }
        },
        "required": [
          "target_device_id",
          "capability",
          "input",
          "ttl_seconds"
        ],
        "additionalProperties": false
      },
      "TaskResult": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "unknown"
            ]
          },
          "output": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "message": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
