{
  "name": "anylink-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AnyLink Android local Agent, built with HBuilderX and uni-app Vue 3",
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:app": "npm run prepare:runtime && npm run prepare:assets",
    "build:preview": "node scripts/build.mjs",
    "build:app": "node scripts/build.mjs --app",
    "preview": "node scripts/preview.mjs",
    "pair:preview": "node scripts/pair-device.mjs --preview",
    "test:live": "node scripts/live-acceptance.mjs",
    "test:runtime": "node --experimental-vm-modules scripts/verify-runtime.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
